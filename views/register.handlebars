<form class="bg-white w-1/4 h-8/13 flex flex-col items-start justify-evenly p-8 py-0 mt-16 rounded-sm">
    <span class="w-full flex flex-col gap-4">
        <span class="w-full flex flex-col gap">
            <label class="font-bold" for="name">Name</label>
            <input class="w-full p-2 border-gray-100 border-2 rounded-md" type="text" name="name" placeholder="John Smith">
        </span>

        <span class="w-full flex flex-col gap">
            <label class="font-bold" for="email">Email</label>
            <input class="w-full p-2 border-gray-100 border-2 rounded-md" type="text" name="email" placeholder="johnsmith@gmail.com">
        </span>

        <span class="w-full flex flex-col gap">
            <label class="font-bold" for="password">Password</label>
            <input class="w-full p-2 border-gray-100 border-2 rounded-md" type="password" name="password" placeholder="****************">
        </span>
    </span>

    <button class="justify-self-start bg-teal-400 text-white w-24 p-2 rounded-sm cursor-pointer">Sign In</button>
</form>